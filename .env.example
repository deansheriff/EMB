APP_NAME="EMB Chronicles"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Africa/Lagos
SESSION_SECURE=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=emb_chronicles
DB_USERNAME=root
DB_PASSWORD=
DB_BOOTSTRAP=true
DB_WAIT_TIMEOUT=60

UPLOAD_MAX_MB=8
GRANT_UPLOAD_TOTAL_MB=18

# Production only: replaces the seeded admin password on container start (12+ characters).
ADMIN_INITIAL_PASSWORD=
# Read the visitor IP from X-Forwarded-For (true behind Coolify/Traefik).
TRUST_PROXY=false

# Optional default SMTP settings, copied into Admin -> Site settings once when SMTP is empty.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional default Paystack keys, copied into Admin -> Site settings once when the secret key is empty.
PAYSTACK_ENABLED=false
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
